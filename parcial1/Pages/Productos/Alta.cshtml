@page
@model parcial1.Pages.Productos.AltaModel
@{
    ViewData["Title"] = "Alta de Producto"; }
<h1>Alta de producto</h1>
@if (Model.Mensaje != null){<div class="alerta ok">@Model.Mensaje</div>}
<form method="post" class="formulario">
    <label asp-for="Nombre">Nombre</label>
    <input asp-for="Nombre" />
    <span asp-validation-for="Nombre" class="error"></span>

    <label asp-for="Precio">Precio</label>
    <input asp-for="Precio" type="number" step="0.01" value="@(Model.Precio == 0 ? "" : Model.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
    <span asp-validation-for="Precio" class="error"></span>

    <label asp-for="IdCategoria">Categoria</label>
    <select asp-for="IdCategoria">
        <option value="0"> -- Seleccione -- </option>
        @foreach (var c in Model.Categorias)
        {
            <option value="@c.IdCategoria" selected="@(c.IdCategoria == Model.IdCategoria)">@c.Descripcion</option>
        }
    </select>
    <span asp-validation-for="IdCategoria" class="error"></span>
    <button type="submit" class="btn verde">Confirmar</button>

</form>
<a asp-page="/Index" class="volver">Volver a la pagina principal</a>