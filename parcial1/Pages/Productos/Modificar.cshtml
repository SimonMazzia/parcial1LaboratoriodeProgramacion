
@page
@model parcial1.Pages.Productos.ModificarModel
@{
    ViewData["Title"] = "Modificar producto";
}

<h1>Modificacion de producto</h1>
@if (Model.Mensaje != null){<div class="alerta ok">@Model.Mensaje</div>}
@if (Model.MensajeError != null) {<div class="alerta error-box">@Model.MensajeError</div>}

<form method="get" class="formulario">
    <label>Producto a modificar</label>
    <select name="id" onchange="this.form.submit()">
        <option value="">--Seleccione un producto--</option>
        @foreach (var p in Model.Productos) {<option value="@p.IdProducto" selected="@(p.IdProducto == Model.Id)">#@p.IdProducto - @p.Nombre</option>}
    </select>
</form>
@if (Model.Id.HasValue && Model.Productos.Any(p=> p.IdProducto == Model.Id))
{
    <form method="post" class="formulario">
        <input type="hidden" asp-for="Id" />
        <label asp-for="Nombre">Nombre</label>
        <input asp-for = "Nombre" />
        <span asp-validation-for= "Nombre" class="error"></span>

        <label asp-for="Precio">Precio</label>
        <input asp-for="Precio" type="number" step="0.01" value="@Model.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <span asp-validation-for="Precio" class="error"></span>

        
        <label asp-for="IdCategoria">Categoria</label>
        <select asp-for="IdCategoria">
            <option value="0"> -- Seleccione -- </option>
            @foreach (var c in Model.Categorias)
            {
                <option value="@c.IdCategoria" selected="@(c.IdCategoria == Model.IdCategoria)">@c.Descripcion</option>
            }
        </select>
        <span asp-validation-for="Nombre" class="error"></span>
        <button type="submit" class="btn naranja">Guardar Cambios</button>
    </form>
    <a asp-page ="/Index" class="volver">Volver a la pagina principal</a>
}
